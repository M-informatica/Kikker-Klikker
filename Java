// --- GAME STATE ---
let currentGrade = 1;
let currentMode = 'practice';
let score = 0;
let timeRemaining = 300;
let timerInterval = null;
let questionStartTime = 0;
let totalQuestionsAnswered = 0;
let correctQuestionsCount = 0;
let activeQuestion = null;
let questionPool = [];

let frogEnergy = 100;
let frogYPosition = 0;

// --- NAVIGATIE ---
function showScreen(screenId) {
  document.getElementById('screen-main').classList.add('hidden');
  document.getElementById('screen-game').classList.add('hidden');
  document.getElementById('game-hud').classList.add('hidden');
  document.getElementById('modal-question').classList.add('hidden');
  document.getElementById('modal-feedback').classList.add('hidden');
  document.getElementById('modal-scoreboard').classList.add('hidden');

  if (screenId === 'screen-main') {
    clearInterval(timerInterval);
  }

  document.getElementById(screenId).classList.remove('hidden');
}

function startGame(grade, mode) {
  currentGrade = grade;
  currentMode = mode;
  score = 0;
  timeRemaining = 300;
  totalQuestionsAnswered = 0;
  correctQuestionsCount = 0;
  frogEnergy = 100;
  frogYPosition = 0;

  questionPool = shuffleArray([...(grade === 1 ? QUESTIONS_GRADE_1 : QUESTIONS_GRADE_2)]);

  document.getElementById('ui-score').textContent = score;
  document.getElementById('ui-timer').textContent = "05:00";
  document.getElementById('game-hud').classList.remove('hidden');

  showScreen('screen-game');

  if (grade === 2) {
    document.getElementById('game2-controls').classList.remove('hidden');
  } else {
    document.getElementById('game2-controls').classList.add('hidden');
  }

  startTimer();
  initCanvasGame();
}

function startTimer() {
  clearInterval(timerInterval);
  timerInterval = setInterval(() => {
    timeRemaining--;
    let mins = Math.floor(timeRemaining / 60);
    let secs = timeRemaining % 60;
    document.getElementById('ui-timer').textContent = `\({mins.toString().padStart(2, '0')}:\){secs.toString().padStart(2, '0')}`;

    if (timeRemaining <= 0) {
      endGame();
    }
  }, 1000);
}

function endGame() {
  clearInterval(timerInterval);
  document.getElementById('modal-question').classList.add('hidden');
  document.getElementById('modal-feedback').classList.add('hidden');

  document.getElementById('res-score').textContent = score;
  document.getElementById('res-total-q').textContent = totalQuestionsAnswered;
  document.getElementById('res-correct-q').textContent = correctQuestionsCount;
  document.getElementById('result-mode-subtitle').textContent = `\({currentGrade} HAVO/VWO -\){currentMode === 'practice' ? 'Oefenmodus' : 'Toetsmodus'}`;

  if (currentMode === 'test') {
    let ratio = totalQuestionsAnswered > 0 ? (correctQuestionsCount / totalQuestionsAnswered) : 0;
    let gradeVal = Math.max(1.0, Math.min(10.0, (1.0 + ratio * 9.0))).toFixed(1);
    document.getElementById('res-grade').textContent = gradeVal;
    document.getElementById('res-grade-row').classList.remove('hidden');
  } else {
    document.getElementById('res-grade-row').classList.add('hidden');
  }

  document.getElementById('modal-scoreboard').classList.remove('hidden');
}

// --- VRAGEN LOGICA ---
function triggerQuestion(callbackOnCorrect) {
  if (questionPool.length === 0) {
    questionPool = shuffleArray([...(currentGrade === 1 ? QUESTIONS_GRADE_1 : QUESTIONS_GRADE_2)]);
  }

  activeQuestion = questionPool.pop();
  questionStartTime = Date.now();

  const hintBadge = document.getElementById('hint-badge');
  if (currentMode === 'practice') {
    const correctText = activeQuestion.options[activeQuestion.answer];
    hintBadge.textContent = `💡 Hint: Eerste letter is '${correctText.charAt(0)}'`;
    hintBadge.classList.remove('hidden');
  } else {
    hintBadge.classList.add('hidden');
  }

  document.getElementById('question-text').textContent = activeQuestion.q;
  document.getElementById('encouragement-toast').textContent = ENCOURAGEMENTS[Math.floor(Math.random() * ENCOURAGEMENTS.length)];

  const container = document.getElementById('options-container');
  container.innerHTML = '';

  let optionObjects = activeQuestion.options.map((opt, idx) => ({ text: opt, isCorrect: idx === activeQuestion.answer }));
  optionObjects = shuffleArray(optionObjects);

  optionObjects.forEach(optObj => {
    const btn = document.createElement('button');
    btn.className = 'btn-action w-full bg-slate-800 hover:bg-slate-700 border border-gray-600 rounded-xl py-3 px-4 text-sm font-semibold text-left text-gray-100 flex items-center justify-between';
    btn.textContent = optObj.text;
    btn.onclick = () => handleAnswerSelect(optObj.isCorrect, callbackOnCorrect);
    container.appendChild(btn);
  });

  document.getElementById('modal-question').classList.remove('hidden');
}

function handleAnswerSelect(isCorrect, callbackOnCorrect) {
  document.getElementById('modal-question').classList.add('hidden');
  totalQuestionsAnswered++;
  let timeTakenSec = (Date.now() - questionStartTime) / 1000;

  if (isCorrect) {
    sound.play('correct');
    correctQuestionsCount++;

    let ptsGained = 5;
    if (currentMode === 'test') {
      if (timeTakenSec <= 20) {
        ptsGained += 1;
        let speedBonus = Math.floor((20 - timeTakenSec) / 5);
        ptsGained += Math.max(0, speedBonus);
      }
    }

    score += ptsGained;
    document.getElementById('ui-score').textContent = score;

    if (callbackOnCorrect) callbackOnCorrect();

  } else {
    sound.play('wrong');

    if (currentMode === 'practice') {
      questionPool.unshift(activeQuestion);
      document.getElementById('feedback-correct-ans').textContent = `Juiste antwoord: ${activeQuestion.options[activeQuestion.answer]}`;
      document.getElementById('feedback-explanation').textContent = activeQuestion.exp;
      document.getElementById('modal-feedback').classList.remove('hidden');
    }
  }
}

function closeFeedbackModal() {
  document.getElementById('modal-feedback').classList.add('hidden');
}

// --- CANVAS ENGINE ---
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
let fishingState = 'idle';
let catchAnimItem = null;

function initCanvasGame() {
  fishingState = 'idle';
  catchAnimItem = null;
}

canvas.addEventListener('click', () => {
  if (currentGrade === 1 && fishingState === 'idle') {
    fishingState = 'casting';
    sound.play('jump');

    setTimeout(() => {
      fishingState = 'waiting';
      triggerQuestion(() => {
        let totalWeight = CATCHABLES.reduce((sum, c) => sum + c.weight, 0);
        let rand = Math.random() * totalWeight;
        let chosen = CATCHABLES[0];

        for (let c of CATCHABLES) {
          if (rand < c.weight) { chosen = c; break; }
          rand -= c.weight;
        }

        catchAnimItem = chosen;
        score += chosen.pts;
        document.getElementById('ui-score').textContent = score;
        fishingState = 'caught';

        setTimeout(() => {
          fishingState = 'idle';
          catchAnimItem = null;
        }, 2000);
      });
    }, 600);
  }
});

document.getElementById('btn-jump').addEventListener('click', () => {
  if (currentGrade === 2) {
    if (frogEnergy >= 25) {
      frogEnergy -= 25;
      frogYPosition += 60;
      sound.play('jump');
    } else {
      alert('Je energie is op! Beantwoord een vraag om energie op te laden.');
    }
  }
});

document.getElementById('btn-answer-energy').addEventListener('click', () => {
  if (currentGrade === 2) {
    triggerQuestion(() => {
      frogEnergy = Math.min(100, frogEnergy + 20);
    });
  }
});

function renderLoop() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  if (currentGrade === 1) {
    ctx.fillStyle = '#1e3799';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.fillStyle = '#0a3d62';
    ctx.fillRect(0, 250, canvas.width, 350);

    ctx.fillStyle = '#784e2d';
    ctx.fillRect(50, 220, 180, 40);

    drawFrog(ctx, 160, 170, 50, 50);

    ctx.strokeStyle = '#f6b93b'; ctx.lineWidth = 4;
    ctx.beginPath(); ctx.moveTo(190, 190); ctx.lineTo(260, 140); ctx.stroke();

    ctx.strokeStyle = 'rgba(255,255,255,0.7)'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(260, 140);

    if (fishingState === 'idle') {
      ctx.lineTo(260, 280);
    } else if (fishingState === 'casting' || fishingState === 'waiting') {
      ctx.lineTo(500, 380);
      ctx.fillStyle = '#e15f41'; ctx.beginPath(); ctx.arc(500, 380, 8, 0, Math.PI*2); ctx.fill();
    } else if (fishingState === 'caught') {
      ctx.lineTo(260, 200);
      if (catchAnimItem) {
        ctx.font = '36px sans-serif';
        ctx.fillText(catchAnimItem.icon, 240, 180);
        ctx.font = 'bold 16px Fredoka One';
        ctx.fillStyle = '#f6b93b';
        ctx.fillText(`+${catchAnimItem.pts} PNT!`, 230, 140);
      }
    }
    ctx.stroke();

    if (fishingState === 'idle') {
      ctx.fillStyle = '#ffffff'; ctx.font = '16px Outfit';
      ctx.fillText("Klik op het scherm om je hengel uit te gooien! 🎣", 250, 100);
    }

  } else {
    ctx.fillStyle = '#0a3d62';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    let startY = (canvas.height - 100) + (frogYPosition % 120);
    for (let y = startY; y > -100; y -= 120) {
      ctx.fillStyle = '#2ed573';
      ctx.beginPath();
      ctx.arc(canvas.width / 2, y, 45, 0, Math.PI * 1.8);
      ctx.lineTo(canvas.width / 2, y);
      ctx.fill();
    }

    drawFrog(ctx, canvas.width / 2 - 25, canvas.height - 130, 50, 50);

    ctx.fillStyle = 'rgba(0,0,0,0.5)';
    ctx.fillRect(20, 20, 220, 50);

    ctx.fillStyle = '#fff'; ctx.font = '12px Outfit';
    ctx.fillText(`ENERGIE: ${frogEnergy}%`, 30, 38);

    ctx.fillStyle = '#333'; ctx.fillRect(30, 45, 200, 15);
    ctx.fillStyle = frogEnergy > 25 ? '#2ecc71' : '#e74c3c';
    ctx.fillRect(30, 45, (frogEnergy / 100) * 200, 15);
  }

  requestAnimationFrame(renderLoop);
}

function drawFrog(c, x, y, width, height) {
  c.save();
  c.translate(x + width / 2, y + height / 2);

  c.fillStyle = '#2ecc71';
  c.beginPath(); c.ellipse(0, 0, width * 0.4, height * 0.4, 0, 0, Math.PI * 2); c.fill();

  c.fillStyle = '#ffffff';
  c.beginPath(); c.arc(-width * 0.2, -height * 0.3, 8, 0, Math.PI * 2); c.fill();
  c.beginPath(); c.arc(width * 0.2, -height * 0.3, 8, 0, Math.PI * 2); c.fill();

  c.fillStyle = '#000000';
  c.beginPath(); c.arc(-width * 0.2, -height * 0.3, 4, 0, Math.PI * 2); c.fill();
  c.beginPath(); c.arc(width * 0.2, -height * 0.3, 4, 0, Math.PI * 2); c.fill();

  c.restore();
}

function shuffleArray(arr) {
  return arr.sort(() => Math.random() - 0.5);
}

requestAnimationFrame(renderLoop);